@@ -0,0 +1,80 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+
+from copy import deepcopy
+
+import pytest
+from transformers import AutoTokenizer
+
+from vllm.reasoning.hy_v4_reasoning_parser import HYV4ReasoningParser
+
+
+@pytest.fixture(scope="module")
+def hy_v4_tokenizer():
+    return AutoTokenizer.from_pretrained("tencent/Hy4-preview")
+
+
+@pytest.mark.parametrize(
+    "previous_text, skip_special_tokens", [("", False), ("\n", False), ("", True)]
+)
+def test_grouped_start_marker(hy_v4_tokenizer, previous_text, skip_special_tokens):
+    tokenizer = deepcopy(hy_v4_tokenizer)
+    parser = HYV4ReasoningParser(tokenizer)
+    tokenizer.add_tokens([parser.reasoning_start_str], special_tokens=True)
+    token_ids = tokenizer.encode(
+        parser.reasoning_start_str + "step one", add_special_tokens=False
+    )
+    delta_text = tokenizer.decode(token_ids, skip_special_tokens=skip_special_tokens)
+    previous_ids = tokenizer.encode(previous_text, add_special_tokens=False)
+
+    delta = parser.extract_reasoning_streaming(
+        previous_text,
+        previous_text + delta_text,
+        delta_text,
+        previous_ids,
+        previous_ids + token_ids,
+        token_ids,
+    )
+
+    assert delta is not None
+    assert delta.reasoning == "step one"
+    assert delta.content is None
+
+
+@pytest.mark.parametrize("include_start_marker", [False, True])
+def test_grouped_reasoning_and_content(hy_v4_tokenizer, include_start_marker):
+    parser = HYV4ReasoningParser(hy_v4_tokenizer)
+    text = "step one" + parser.reasoning_end_str + "answer"
+    if include_start_marker:
+        text = parser.reasoning_start_str + text
+    token_ids = hy_v4_tokenizer.encode(text, add_special_tokens=False)
+    delta_text = hy_v4_tokenizer.decode(token_ids, skip_special_tokens=False)
+
+    delta = parser.extract_reasoning_streaming(
+        "", delta_text, delta_text, [], token_ids, token_ids
+    )
+
+    assert delta is not None
+    assert delta.reasoning == "step one"
+    assert delta.content == "answer"
+
+
+@pytest.mark.parametrize("previous_text", ["", "initial reasoning "])
+def test_literal_start_marker_is_preserved(hy_v4_tokenizer, previous_text):
+    parser = HYV4ReasoningParser(hy_v4_tokenizer)
+    delta_text = "quote " + parser.reasoning_start_str + " here"
+    previous_ids = hy_v4_tokenizer.encode(previous_text, add_special_tokens=False)
+    delta_ids = hy_v4_tokenizer.encode(delta_text, add_special_tokens=False)
+
+    delta = parser.extract_reasoning_streaming(
+        previous_text,
+        previous_text + delta_text,
+        delta_text,
+        previous_ids,
+        previous_ids + delta_ids,
+        delta_ids,
+    )
+
+    assert delta is not None
+    assert delta.reasoning == delta_text
+    assert delta.content is None
